# Copy to .env.local and fill in. Everything is optional in dev; leads fail over to email/logs.

# Zoho CRM — Self Client at https://api-console.zoho.in (scope: ZohoCRM.modules.leads.ALL)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.in

# Google Sheet (Apps Script web app, see apps-script/Code.gs)
GSHEET_WEBAPP_URL=
GSHEET_SECRET=

# Email alerts (Resend — https://resend.com). TO can be comma-separated.
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
RESEND_API_KEY=

# WhatsApp via Interakt — Settings → Developer Settings → Secret Key
WHATSAPP_API_KEY=
# Number that RECEIVES lead alerts (must not be the Interakt business number itself)
WHATSAPP_SALES_NUMBER=
# Approved template names. Sales: {{1}} name {{2}} mobile {{3}} project type {{4}} company {{5}} status
WHATSAPP_SALES_TEMPLATE=new_lead_alert
# Lead auto-reply: {{1}} first name {{2}} project type (leave empty to disable)
WHATSAPP_LEAD_TEMPLATE=walkthrough_quote_received
WHATSAPP_TEMPLATE_LANG=en

# Anti-spam
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Tracking
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_SGTM_URL=

# Contact (shown on the page)
NEXT_PUBLIC_WHATSAPP_NUMBER=9673439102
NEXT_PUBLIC_PHONE_NUMBER=9673439102

# Video (Mux or Cloudflare Stream)
MUX_TOKEN_ID=
CLOUDFLARE_STREAM_TOKEN=
