# Copy to .env.local and fill in. Everything is optional in dev; leads fail over to email/logs.

# Zoho CRM
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.in

# Google Sheet (Apps Script web app, see apps-script/Code.gs)
GSHEET_WEBAPP_URL=https://script.google.com/macros/s/<deployment-id>/exec
GSHEET_SECRET=

# Notifications
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
RESEND_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SALES_NUMBER=

# Anti-spam
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Tracking
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_SGTM_URL=

# Contact (shown on the page)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_NUMBER=

# Video (Mux or Cloudflare Stream)
MUX_TOKEN_ID=
CLOUDFLARE_STREAM_TOKEN=
